# Copy to .env and fill in real values. Never commit .env.
#
# Prerequisites before anything in backend/ will run against real services:
#   1. Fill in every value below.
#   2. Run: gcloud auth application-default login
#   3. Confirm Earth Engine is registered for GCP_PROJECT_ID:
#      https://console.cloud.google.com/earth-engine
#   4. For subsidence/wildfire jobs only, register the two extra credentials
#      flagged below (not part of the original provisioned set).

# --- Google Cloud ---
GCP_PROJECT_ID=
BQ_DATASET=landrisk
EE_PROJECT=

# --- Redis (local dev: docker-compose up redis) ---
REDIS_URL=redis://localhost:6379/0

# --- TypeSafe / Jev ---
# Pin an exact version, never "jev-latest" (see design doc: thresholds are
# re-tuned before any version bump).
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_CONFIDENCE_THRESHOLD=0.6

# --- Gemini (LLM report writer) ---
# Verify this model id in your Google AI Studio / Vertex account before
# relying on the default -- taken verbatim from the design doc, not
# independently confirmed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- NASA Earthdata (subsidence job: OPERA DISP-S1 via earthaccess) ---
# New requirement, not in the original provisioned credential list.
# Register free at: https://urs.earthdata.nasa.gov/
EARTHDATA_TOKEN=

# --- NASA FIRMS (wildfire job: VIIRS active fire archive) ---
# New requirement, not in the original provisioned credential list.
# Register free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- App ---
APP_ENV=local
