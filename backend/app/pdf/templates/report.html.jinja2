<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<style>
  body { font-family: "Helvetica Neue", Arial, sans-serif; color: #1a1a1a; margin: 2.5cm; }
  h1 { font-size: 22pt; margin-bottom: 0.2em; }
  h2 { font-size: 15pt; margin-top: 1.2em; border-bottom: 1px solid #ccc; padding-bottom: 0.2em; }
  .meta { color: #666; font-size: 9pt; margin-bottom: 1.5em; }
  .disclaimer { font-size: 8pt; color: #666; margin-top: 2em; border-top: 1px solid #ccc; padding-top: 0.8em; }
  .attribution { font-size: 7pt; color: #999; margin-top: 0.5em; }
</style>
</head>
<body>
  <div class="meta">
    Report ID: {{ report_id }} &middot; Parcel: {{ parcel_id }} &middot; Data version: {{ data_version }}
  </div>
  {{ body_html | safe }}
  <div class="attribution">
    Includes AlphaEarth annual embeddings data, licensed CC-BY 4.0.
  </div>
</body>
</html>
